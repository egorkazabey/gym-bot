# токен от @BotFather
BOT_TOKEN=123456:ABC...
# твой Telegram ID (узнать у @userinfobot). Если пусто, ботом может пользоваться кто угодно
ALLOWED_USERS=
# где хранить базу. На хостинге укажи папку, которая не стирается при обновлении
DB_PATH=data/gym.db
TZ_NAME=Europe/Prague
# мини-апп: публичный https-адрес, по которому доступен этот сервер. Пусто = мини-апп выключен
WEBAPP_URL=
# порт веб-сервера мини-аппа (многие хостинги задают его сами)
PORT=8080
